{
  "manifest_version": 3,
  "name": "CarlUI",
  "short_name": "CarlUI",
  "version": "1.5.0",
  "default_locale": "en",
  "description": "__MSG_desc__",
  "permissions": ["downloads", "cookies", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47321/*"],
  "content_scripts": [
    { "matches": ["https://*/*", "http://localhost/*"], "js": ["passkey-page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://*/*", "http://localhost/*"], "js": ["passkey-relay.js"], "run_at": "document_start" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "__MSG_fill__",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "__MSG_fill__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "downloads@carlui.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
